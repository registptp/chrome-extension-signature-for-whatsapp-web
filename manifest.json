{
  "manifest_version": 3,
  "name": "Signature for WhatsApp Web",
  "version": "1.4",
  "description": "Adiciona automaticamente sua assinatura nas mensagens do WhatsApp Web.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Signature for WhatsApp Web",
    "default_popup": "popup.html"
  }
}
